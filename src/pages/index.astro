import BaseLayout from '../layouts/BaseLayout.astro';
import {
  aiPipeline,
  foundations,
  goals,
  governanceGroups,
  leaders,
  participation,
  supportOrganizations,
  timeline,
} from '../data/site';
import { withBase } from '../lib/paths';
import { siteConfig } from '../../site.config.mjs';

const institutions = [
  {
    name: 'Beth Israel Deaconess Medical Center',
    href: 'https://www.bidmc.org/',
    logo: '/images/institutions/bidmc.svg',
  },
  {
    name: 'Harvard University',
    href: 'https://www.harvard.edu/',
    logo: '/images/institutions/harvard.svg',
  },
  {
    name: 'Stanford University',
    href: 'https://www.stanford.edu/',
    logo: '/images/institutions/stanford-university.svg',
  },
  {
    name: 'Stanford Medicine',
    href: 'https://med.stanford.edu/',
    logo: '/images/institutions/stanford-medicine.svg',
  },
  {
    name: 'American Psychiatric Association',
    href: 'https://www.psychiatry.org/',
    logo: '/images/institutions/apa.svg',
  },
] as const;

const foundationList = `${foundations.slice(0, -1).join(', ')}, and ${foundations.at(-1)}`;
const participationPath = withBase(siteConfig.participation.path);
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1>Interoperable sensor data for research and AI.</h1>
        <p class="hero-summary">
          DIGITS brings researchers, clinicians, standards experts, and technology partners together
          to make wearable and smartphone data portable, interpretable, and ready for large-scale
          medical research. Without a shared representation, data from different devices cannot be
          combined, compared, or reused.
        </p>
        <div class="hero-actions">
          <a class="button" href={participationPath}>
            Join the consortium
          </a>
          <a class="text-link" href="#approach">
            See the approach
          </a>
        </div>
      </div>

      <div
        class="hero-panel"
        aria-label="The same heart rate measurement as named by four platforms"
      >
        <p class="hero-panel-title">One heart rate, four names</p>
        <dl>
          <div>
            <dt>Apple HealthKit</dt>
            <dd>
              <code>HKQuantityTypeIdentifierHeartRate</code>
            </dd>
          </div>
          <div>
            <dt>Android Health Connect</dt>
            <dd>
              <code>HeartRateRecord</code>
            </dd>
          </div>
          <div>
            <dt>Apple SensorKit</dt>
            <dd>
              <code>SRSensor.heartRate</code>
            </dd>
          </div>
          <div>
            <dt>Oura</dt>
            <dd>
              <code>heartrate</code>
            </dd>
          </div>
          <div class="hero-panel-result">
            <dt>Shared representation</dt>
            <dd>Heart rate, LOINC 8867-4, beats per minute</dd>
          </div>
        </dl>
        <p>Today every study rewrites this mapping itself, and every study does it differently.</p>
      </div>
    </div>
  </section>

  <section class="institution-band" aria-labelledby="institutions-title">
    <div class="container">
      <h2 id="institutions-title" class="visually-hidden">
        Institutions contributing leadership and stewardship
      </h2>
      <div class="institution-grid">
        {institutions.map((institution) => (
          <a href={institution.href} class="institution-lockup" aria-label={institution.name}>
            <img src={withBase(institution.logo)} alt={institution.name} loading="eager" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="approach" class="section">
    <div class="container">
      <h2>What DIGITS does</h2>
      <div class="prose">
        <p>
          DIGITS aims to make sensor data comparable and traceable across devices, software
          versions, and studies. This helps researchers assemble larger longitudinal cohorts and
          evaluate AI across real-world populations. A shared data layer also opens the door to
          multimodal models and agentic health applications that can be developed, tested, and
          reproduced responsibly.
        </p>
        <p>
          <strong>DIGITS is not another competing standard.</strong> It connects and extends
          established foundations with the profiles, mappings, adapters, validation tools, and
          implementation evidence needed for research use. The work builds on {foundationList}.
        </p>
        <p>
          DIGITS maintains an open reference implementation with a source-neutral core, adapters for
          Apple HealthKit, Android Health Connect, Apple SensorKit, and connected wearable
          providers, and a machine-readable catalog of measurement definitions. It is currently in
          release-candidate status.
        </p>
      </div>
      <dl class="pipeline">
        {aiPipeline.map((stage) => (
          <div>
            <dt>{stage.label}</dt>
            <dd>{stage.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="goals" class="section">
    <div class="container">
      <h2>Goals</h2>
      <p class="prose body-large">
        DIGITS is supported by the National Institute of Mental Health through the NIH initiative{' '}
        <a href="https://grants.nih.gov/grants/guide/pa-files/PAR-24-250.html">
          Standardizing Data and Metadata from Wearable Devices (PAR-24-250)
        </a>
        . The work combines community governance, landscape assessment, implementation, validation,
        adoption support, and long-term stewardship.
      </p>
      <ol class="goal-list">
        {goals.map((goal) => (
          <li>
            <div>
              <h3>{goal.title}</h3>
              <p>{goal.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="consortium" class="section">
    <div class="container">
      <h2>Governance</h2>
      <div class="prose">
        <p>
          The proposed structure combines accountable leadership, independent ethical review, a
          representative consortium, and focused working groups where the implementation work
          happens.
        </p>
        <p>
          A Governance Board with clinical, informatics, and industry co-chairs sets direction. An
          independent Ethical Advisory Board of 8–12 members provides oversight. The Consortium is
          the deliberative body, with a target of 40–50 members. Working groups of 6–10 members each
          operate against defined deliverables and report to the Governance Board. Additional groups
          can be chartered as priorities evolve.
        </p>
      </div>
      <h3 class="subheading">Working groups</h3>
      <ul class="plain-list">
        {governanceGroups.map((group) => (
          <li>
            <strong>{group.name}.</strong> {group.detail}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="team" class="section">
    <div class="container">
      <h2>Leadership</h2>
      <p class="prose">
        The founding co-chairs connect clinical priorities, implementation expertise, and the
        realities of device and platform development.
      </p>
      <div class="leader-grid">
        {leaders.map((leader) => (
          <article class="leader-card">
            <img
              src={withBase(leader.image)}
              alt={leader.imageAlt}
              width="350"
              height="350"
              loading="eager"
              style={`object-position: ${leader.imagePosition}`}
            />
            <div class="leader-copy">
              <h3>{leader.name}</h3>
              <p class="leader-role">{leader.role}</p>
              <p>{leader.affiliation}</p>
              {leader.profile && <a href={leader.profile}>Profile</a>}
            </div>
          </article>
        ))}
      </div>
      <p class="prose">
        The American Psychiatric Association will help provide a lasting home for specifications,
        training, governance, and continued adoption beyond the initial award.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="support-title">
    <div class="container">
      <h2 id="support-title">Supporting organizations</h2>
      <p class="prose">
        Leaders affiliated with these organizations provided letters of support for the original
        grant submission. DIGITS is growing that early network into a broader consortium spanning
        devices, platforms, research, healthcare, standards, advocacy, and publishing.
      </p>
      <ul class="support-grid" aria-label="Organizations affiliated with initial letter writers">
        {supportOrganizations.map((organization) => (
          <li class:list={{ compact: organization.compact }}>
            <img src={withBase(organization.logo)} alt={organization.name} loading="eager" />
          </li>
        ))}
      </ul>
      <p class="prose note">
        Affiliations reflect the letter writers identified in the funded proposal. New academic,
        industry, standards, and community partners are invited to join.
      </p>
    </div>
  </section>

  <section id="timeline" class="section">
    <div class="container">
      <h2>Timeline</h2>
      <p class="prose">
        Each phase creates a concrete opportunity for academic and industry partners to shape,
        implement, test, and extend the work.
      </p>
      <table class="timeline-table">
        <thead>
          <tr>
            <th scope="col">Period</th>
            <th scope="col">Phase</th>
            <th scope="col">Focus</th>
            <th scope="col">How to engage</th>
          </tr>
        </thead>
        <tbody>
          {timeline.map((phase) => (
            <tr>
              <th scope="row" data-label="Period">
                {phase.period}
              </th>
              <td data-label="Phase">{phase.title}</td>
              <td data-label="Focus">{phase.detail}</td>
              <td data-label="How to engage">{phase.engagement}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="participate" class="section">
    <div class="container">
      <h2>Get involved</h2>
      <p class="prose">
        Early members will help set implementation priorities and establish the adapter patterns,
        validation methods, and governance that future studies and platforms can build on. We are
        especially seeking device and platform teams ready to make their systems easier to use in
        rigorous, large-scale medical research.
      </p>
      <ul class="participation-list">
        {participation.map((item) => (
          <li>
            <h3>{item.audience}</h3>
            <p>{item.description}</p>
            <a href={participationPath}>{item.action}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-inner">
      <div>
        <h2>Become a founding member</h2>
        <p>
          Founding participants can influence the first use cases and implementation patterns and
          contribute the adapters that make their devices, platforms, and research workflows part of
          an interoperable future.
        </p>
      </div>
      <a class="button button-light" href={participationPath}>
        Join the founding consortium
      </a>
    </div>
  </section>
</BaseLayout>
