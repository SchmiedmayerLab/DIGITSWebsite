import BaseLayout from '../layouts/BaseLayout.astro';
import DigitsMark from '../components/DigitsMark.astro';
import {
  aiPipeline,
  foundations,
  goals,
  governanceGroups,
  leaders,
  participation,
  timeline,
} from '../data/site';
import { withBase } from '../lib/paths';
import { siteConfig } from '../../site.config.mjs';

const institutions = [
  {
    name: 'Beth Israel Deaconess Medical Center',
    href: 'https://brain.harvard.edu/?people=john-torous',
    logo: '/images/institutions/bidmc.svg',
  },
  {
    name: 'Harvard University',
    href: 'https://brain.harvard.edu/?people=john-torous',
    logo: '/images/institutions/harvard.svg',
  },
  {
    name: 'Stanford University',
    href: 'https://profiles.stanford.edu/schmiedmayer',
    logo: '/images/institutions/stanford-university.svg',
  },
  {
    name: 'Stanford Medicine',
    href: 'https://profiles.stanford.edu/schmiedmayer',
    logo: '/images/institutions/stanford-medicine.svg',
  },
  {
    name: 'American Psychiatric Association',
    href: 'https://www.psychiatry.org/about-apa/meet-our-organization/councils/digital-health-innovation-and-technology',
    logo: '/images/institutions/apa.svg',
  },
] as const;
---

<BaseLayout>
  <section id="top" class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span></span> Across devices, platforms, and vendors
        </p>
        <h1>Interoperable sensor data for research and AI.</h1>
        <p class="hero-summary">
          DIGITS brings researchers, clinicians, standards experts, and technology partners together
          to make wearable and smartphone data portable, interpretable, and ready for large-scale
          medical research. Today, equivalent measurements are represented differently across
          platforms, making them difficult to combine, compare, and reuse.
        </p>
        <div class="hero-actions">
          <a class="button" href={withBase(siteConfig.participation.path)}>
            Join the consortium
          </a>
          <a class="text-link" href="#approach">
            See the approach <span aria-hidden="true">↓</span>
          </a>
        </div>
        <ul class="hero-principles" role="list" aria-label="DIGITS principles">
          <li>Use existing standards</li>
          <li>Include research and industry</li>
          <li>Validate across devices</li>
        </ul>
      </div>

      <div
        class="hero-system"
        aria-label="Raw sensor signals, device-derived measures, and patient-reported data flowing through the DIGITS interoperability layer into consistent research data"
      >
        <p class="system-label">From sensing to interpreted measures</p>
        <div class="signal-stack">
          <div class="signal-card">
            <span class="signal-pulse"></span>
            <strong>Raw signals</strong>
            <small>PPG streams · accelerometry</small>
          </div>
          <div class="signal-card">
            <span class="signal-pulse"></span>
            <strong>Device measures</strong>
            <small>heart rate · sleep stages</small>
          </div>
          <div class="signal-card">
            <span class="signal-pulse"></span>
            <strong>Patient reports</strong>
            <small>symptoms · validated scales</small>
          </div>
        </div>
        <div class="system-flow" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </div>
        <div class="open-core">
          <DigitsMark compact />
          <span class="core-label">Practical interoperability</span>
          <strong>Map · profile · validate</strong>
          <small>Preserve meaning across data sources</small>
        </div>
        <div class="system-flow flow-out" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </div>
        <p class="system-label system-label-out">Comparable research data</p>
        <div class="outcome-grid">
          <span>Shared semantics</span>
          <span>Units + time</span>
          <span>Quality + provenance</span>
          <span>Research-ready series</span>
        </div>
      </div>
    </div>
  </section>

  <section class="institution-band" aria-labelledby="institutions-title">
    <div class="container">
      <h2 id="institutions-title" class="visually-hidden">
        Institutions contributing leadership and stewardship
      </h2>
      <div class="institution-grid">
        {institutions.map((institution) => (
          <a href={institution.href} class="institution-lockup" aria-label={institution.name}>
            <img src={withBase(institution.logo)} alt={institution.name} loading="eager" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="approach" class="section ai-section">
    <div class="container split-heading ai-heading">
      <div>
        <p class="eyebrow eyebrow-light">The shared data foundation</p>
        <h2>Structured sensor data is foundational to medical AI.</h2>
      </div>
      <div>
        <p>
          Models cannot reason reliably across longitudinal health data when equivalent signals
          arrive with different names, units, sampling assumptions, quality indicators, and
          provenance. DIGITS aims to make those signals comparable and traceable across devices,
          software versions, and studies.
        </p>
        <p class="ai-caveat">
          A shared data layer enables larger research cohorts and gives multimodal and agentic
          systems consistent evidence that can be evaluated and reproduced across real-world
          populations.
        </p>
      </div>
    </div>
    <div class="container foundation-strip" aria-label="Existing standards DIGITS builds on">
      <span>Building on</span>
      {foundations.map((foundation) => (
        <strong>{foundation}</strong>
      ))}
    </div>
    <div class="container position-statement position-statement-dark">
      <span class="position-mark" aria-hidden="true">
        ≠
      </span>
      <p>
        <strong>DIGITS is not another competing standard.</strong> It connects and extends
        established foundations with the profiles, mappings, adapters, validation tools, and
        implementation evidence needed for research use.
      </p>
    </div>
    <ol class="container ai-pipeline">
      {aiPipeline.map((stage) => (
        <li>
          <strong>{stage.label}</strong>
          <p>{stage.detail}</p>
        </li>
      ))}
    </ol>
    <div class="container ai-outcomes" aria-label="Potential research outcomes">
      <span>Cross-device digital biomarkers</span>
      <span>Time-series reasoning</span>
      <span>Generalizable multimodal models</span>
      <span>Reproducible agent evaluation</span>
    </div>
    <div class="container ai-connection">
      <div>
        <span class="panel-kicker">Related research</span>
        <h3>From interoperable signals to time-series reasoning</h3>
      </div>
      <p>
        Research such as <a href={siteConfig.references.openTSLM}>OpenTSLM</a> explores how language
        models can reason over multivariate medical text and time-series data. DIGITS addresses a
        prerequisite for this work: portable measurements with explicit meaning, quality, and
        provenance across data sources.
      </p>
    </div>
  </section>

  <section id="goals" class="section goals-section">
    <div class="container">
      <div class="split-heading section-heading">
        <div>
          <p class="eyebrow eyebrow-light">Scope of work</p>
          <h2>Make existing standards practical for research.</h2>
        </div>
        <p class="body-large">
          DIGITS is supported by the National Institute of Mental Health through the NIH initiative{' '}
          <a href="https://grants.nih.gov/grants/guide/pa-files/PAR-24-250.html">
            Standardizing Data and Metadata from Wearable Devices (PAR-24-250)
          </a>
          . The work combines community governance, landscape assessment, implementation,
          validation, adoption support, and long-term stewardship.
        </p>
      </div>
      <div class="goal-list">
        {goals.map((goal) => (
          <article class="goal-card">
            <div>
              <>
                <span class="goal-verb">{goal.verb}</span>
                <h3>{goal.title}</h3>
              </>
            </div>
            <p>{goal.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="consortium" class="section governance-section">
    <div class="container split-heading section-heading governance-heading">
      <div>
        <p class="eyebrow">How the consortium is organized</p>
        <h2>One structure for technical work, oversight, and decisions.</h2>
      </div>
      <p class="body-large">
        The proposed structure combines accountable leadership, independent ethical review, a
        representative consortium, and focused working groups where implementation work happens.
      </p>
    </div>
    <div class="container governance-map" aria-label="DIGITS proposed governance structure">
      <div class="governance-board governance-node">
        <span>Strategic leadership</span>
        <strong>Governance Board</strong>
        <p>Clinical · informatics · industry co-chairs</p>
      </div>
      <div class="governance-branch" aria-hidden="true"></div>
      <div class="governance-middle">
        <div class="governance-node advisory-node">
          <span>Independent oversight</span>
          <strong>Ethical Advisory Board</strong>
          <p>8–12 members</p>
        </div>
        <div class="governance-node consortium-node">
          <span>Deliberative body</span>
          <strong>Consortium</strong>
          <p>Target: 40–50 members</p>
        </div>
      </div>
      <div class="governance-groups">
        {governanceGroups.map((group) => (
          <article>
            <>
              <span>Working group</span>
              <strong>{group.name}</strong>
              <p>{group.detail}</p>
            </>
          </article>
        ))}
      </div>
      <p class="governance-note">
        Working groups are expected to include 6–10 members, operate against defined deliverables,
        and report into the Governance Board. Additional groups can be chartered as priorities
        evolve.
      </p>
    </div>
  </section>

  <section id="team" class="section team-section">
    <div class="container">
      <div class="split-heading section-heading">
        <div>
          <p class="eyebrow eyebrow-light">Founding leadership</p>
          <h2>Co-chairs from clinical care, informatics, and device technology.</h2>
        </div>
        <p class="body-large">
          The founding co-chairs connect clinical priorities, implementation expertise, and the
          realities of device and platform development from the outset.
        </p>
      </div>
      <div class="leader-grid">
        {leaders.map((leader) => (
          <article class="leader-card">
            <img
              src={withBase(leader.image)}
              alt={leader.imageAlt}
              width="350"
              height="350"
              loading="eager"
              style={`object-position: ${leader.imagePosition}`}
            />
            <div class="leader-copy">
              <span class="leader-role">{leader.role}</span>
              <h3>{leader.name}</h3>
              <p>{leader.affiliation}</p>
              {leader.profile && (
                <a href={leader.profile}>
                  View profile <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
      <div class="stewardship-card">
        <div class="stewardship-logo">
          <img
            src={withBase('/images/institutions/apa.svg')}
            alt="American Psychiatric Association"
            loading="eager"
          />
        </div>
        <div>
          <span>Long-term stewardship partner</span>
          <strong>A durable home for community-led interoperability</strong>
        </div>
        <p>
          The American Psychiatric Association will help provide a lasting home for specifications,
          training, governance, and continued adoption beyond the initial award.
        </p>
      </div>
    </div>
  </section>

  <section id="timeline" class="section timeline-section">
    <div class="container split-heading section-heading timeline-heading">
      <div>
        <p class="eyebrow">Four-year workplan</p>
        <h2>Four years from priority setting to long-term stewardship.</h2>
      </div>
      <p class="body-large">
        Each phase creates a concrete opportunity for academic and industry partners to shape,
        implement, test, and extend the work.
      </p>
    </div>
    <ol class="container timeline-list">
      {timeline.map((phase) => (
        <li>
          <span class="timeline-period">{phase.period}</span>
          <div>
            <>
              <strong>{phase.title}</strong>
              <p>{phase.detail}</p>
            </>
          </div>
          <span class="timeline-engagement">{phase.engagement}</span>
        </li>
      ))}
    </ol>
  </section>

  <section id="participate" class="section participate-section">
    <div class="container split-heading section-heading participate-header">
      <div>
        <p class="eyebrow">Join DIGITS</p>
        <h2>Help make wearable and sensor data usable across research systems.</h2>
      </div>
      <p class="body-large">
        Early members will help set implementation priorities and establish the adapter patterns,
        validation methods, and governance that studies and platforms can build on. We are
        especially seeking device and platform teams ready to make their systems easier to use in
        rigorous, large-scale medical research.
      </p>
    </div>
    <div class="container participation-grid">
      {participation.map((item) => (
        <article>
          <h3>{item.audience}</h3>
          <p>{item.description}</p>
          <strong>{item.action}</strong>
        </article>
      ))}
    </div>
    <div class="container contact-panel">
      <div>
        <span class="panel-kicker">Founding participation</span>
        <h3>Contribute to the first implementation priorities.</h3>
        <p>
          Participants can help select initial use cases, review profiles and validation methods,
          test implementations, or build adapters for their systems.
        </p>
      </div>
      <a class="button button-light" href={withBase(siteConfig.participation.path)}>
        Join the founding consortium <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
